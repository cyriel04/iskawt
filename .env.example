# Copy to .env and fill in. Never commit .env.

# Postgres. Local: the Docker container from docker-compose.yml.
# Production: the Neon connection string.
DATABASE_URL=postgresql://iskawt:devpassword@localhost:5432/iskawt

# Better Auth (magic-link sign-in). Secret: 32+ random characters,
# e.g. `openssl rand -base64 32`. URL: the site's public origin.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Outgoing email via Resend. Both required in production; in development,
# leave them empty and emails print to the terminal instead.
RESEND_API_KEY=
EMAIL_FROM=

# Where ops notices go: new reports and new host applications. Ids and a few
# public facts only, reviewed in Prisma Studio. If unset, nothing is lost: rows
# are still saved and a line is logged. (REPORTS_EMAIL_TO, its old name, still works.)
OPS_EMAIL_TO=

# Error monitoring with Sentry (slice 7b). Errors only, scrubbed to an allowlist
# (app/_lib/sentryScrub.ts). Leave the DSNs empty to keep Sentry off (local, CI).
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# Build time only, for uploading source maps. The token is a secret: set it in
# Vercel's environment settings, never here. Without it, builds skip the upload.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
